# Forever matched-gear comparison: level 60 mage Frost (talents from profiles/Mage/mage-60-frost.simc).
# Gear = the common caster budget in README.md (stat totals via gear_*, no real items). Default APL.
mage="Matched_Mage_Frost"
level=60
race=undead
role=spell
class_talents=arcane_focus:3/missile_barrage:2/arcane_concentration:5/arcane_impact:3/arcane_blast:1/arcane_geometry:1/improved_frostbolt:5/elemental_precision:5/ice_shards:5/piercing_ice:3/ice_lance:1/frost_channeling:3/shatter:3/improved_cone_of_cold:3/cold_snap:1/fingers_of_frost:2/winters_chill:5
main_hand=matched_staff,weapon=staff_3.60speed_180min_252max
gear_intellect=150
gear_spirit=100
gear_stamina=250
gear_spell_power=280
gear_hit_rating=30
gear_crit_rating=28
# Default mage APL (engine/class_modules/apl/mage.cpp) with only the mana_potion and dark_rune lines removed:
# no class gets consumables in this comparison (README.md). Mana gems are a class ability and stay.
actions.precombat=arcane_intellect
actions.precombat+=/mage_armor
actions.precombat+=/snapshot_stats
actions=call_action_list,name=mana
actions+=/cold_snap,if=cooldown.cone_of_cold.remains>5&debuff.winters_chill.stack>=debuff.winters_chill.max_stack
actions+=/cone_of_cold,if=!talent.winters_chill|debuff.winters_chill.stack>=debuff.winters_chill.max_stack
actions+=/ice_lance,if=buff.fingers_of_frost.react|target_frozen
actions+=/arcane_missiles,if=buff.missile_barrage.react
actions+=/frostbolt
actions.mana=mana_gem
actions.mana+=/evocation,if=mana.pct<15
