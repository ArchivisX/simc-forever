# Forever matched-gear comparison: level 60 mage Arcane (talents from profiles/Mage/mage-60-arcane.simc).
# Gear = the common caster budget in README.md (stat totals via gear_*, no real items). Default APL.
mage="Matched_Mage_Arcane"
level=60
race=undead
role=spell
class_talents=arcane_focus:5/missile_barrage:2/arcane_concentration:5/arcane_impact:3/arcane_blast:1/arcane_meditation:3/arcane_wrath:1/presence_of_mind:1/arcane_mind:5/arcane_instability:3/arcane_geometry:1/arcane_power:1/incineration:3/improved_fire_blast:2/ignite:5/improved_fireball:5/pyroblast:1/master_of_elements:3/heating_up:1
main_hand=matched_staff,weapon=staff_3.60speed_180min_252max
gear_intellect=150
gear_spirit=100
gear_stamina=250
gear_spell_power=280
gear_hit_rating=30
gear_crit_rating=28
# Default mage APL (engine/class_modules/apl/mage.cpp) with only the mana_potion and dark_rune lines removed:
# no class gets consumables in this comparison (README.md). Mana gems are a class ability and stay.
actions.precombat=arcane_intellect
actions.precombat+=/mage_armor
actions.precombat+=/snapshot_stats
actions.precombat+=/variable,name=ab_stacks,value=2
actions=call_action_list,name=mana
actions+=/arcane_power,if=buff.arcane_blast.stack>=variable.ab_stacks
actions+=/presence_of_mind,if=cooldown.arcane_wrath.ready
actions+=/arcane_wrath
actions+=/arcane_missiles,if=buff.missile_barrage.react
actions+=/arcane_blast,if=buff.arcane_blast.stack<variable.ab_stacks|buff.clearcasting.react
actions+=/arcane_missiles,if=buff.clearcasting.react|mana.pct>50
actions+=/frostbolt
actions.mana=mana_gem
actions.mana+=/evocation,if=mana.pct<15
