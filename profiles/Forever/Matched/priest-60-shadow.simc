# Forever matched-gear comparison: level 60 priest Shadow 14/0/37 (talents from profiles/Sanity/priest-60-shadow.simc).
# Gear = the common caster budget in README.md (stat totals via gear_*, no real items). Default APL.
priest="Matched_Priest_Shadow"
level=60
race=undead
role=spell
class_talents=twin_disciplines:5/mental_strength:5/meditation:3/inner_focus:1/shadow_focus:5/improved_mind_blast:5/improved_shadow_word_pain:2/shadow_reach:2/mind_flay:1/improved_mind_flay:2/dark_inspiration:5/vampiric_embrace:1/shadow_weaving:3/silence:1/devouring_contagion:2/early_demise:2/darkness:5/shadowform:1
main_hand=matched_staff,weapon=staff_3.60speed_180min_252max
gear_intellect=150
gear_spirit=100
gear_stamina=250
gear_spell_power=280
gear_hit_rating=30
gear_crit_rating=28
# Wand: the priest module's own option (min:max:speed:school), ESTIMATE ~54 dps; used only when nothing else is affordable
priest.wand=64:120:1.7:arcane
