# Forever priest sample: level 25 Shadow leveling (16 points) vs a level 25 target, default APL.
# Gear is a stat stand-in for leveling greens. Spells: Mind Blast R4 is level 28, so R3; SW:P R4; Mind Flay R1;
# Devouring Plague R1 (baseline at 20 in Forever). No Shadowform, no SW:D (level 32).
priest="Sample_Priest_Shadow_25"
level=25
race=undead
role=spell
class_talents=shadow_focus:5/improved_mind_blast:5/improved_shadow_word_pain:2/mind_flay:1/improved_mind_flay:2/shadow_weaving:1
main_hand=,id=873
# Wand: ESTIMATE of a level 20 green Shadow wand (~15 DPS). No ranged slot in the engine, so min:max:speed[:school]
priest.wand=18:34:1.7:shadow
gear_intellect=30
gear_spirit=25
gear_stamina=30
target_level=25
